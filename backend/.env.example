# BetsWin engine configuration.
# Copy to `.env` and edit. Never commit a file with real keys in it.

# ---------------------------------------------------------------- server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# ------------------------------------------------------------ data feeds
# Polymarket and Kalshi market data are public. No credentials needed.
ENABLE_POLYMARKET=true
ENABLE_KALSHI=true

# --- UK/EU exchange zone -------------------------------------------------
# Smarkets publishes market data with no credentials, so this can simply be
# turned on. Betfair publishes nothing without an application key, and stays
# dark unless it has one plus either a session token or a login.
ENABLE_SMARKETS=true
SMARKETS_EVENT_TYPES=football_match,politics,politics_outright
SMARKETS_MAX_EVENTS=60

ENABLE_BETFAIR=false
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# 1 = Soccer, 2378961 = Politics.
BETFAIR_EVENT_TYPE_IDS=1,2378961
BETFAIR_MAX_MARKETS=60

# Optional: US sportsbook odds via the-odds-api.com. Without a key the
# sportsbook source stays dark and only prediction markets are scanned.
ODDS_API_KEY=
ODDS_API_REGIONS=us,us2
ODDS_API_SPORTS=americanfootball_nfl,basketball_nba,baseball_mlb,icehockey_nhl

# The Odds API publishes prices, not order books: there is no depth and no stake
# limit in the payload, so a sportsbook leg's capacity is UNKNOWN. This is the
# most one leg at a single book will be sized at -- a risk limit you own, not a
# number the feed reported. 0 disables sportsbook sizing entirely.
SPORTSBOOK_ASSUMED_STAKE_USD=250

# How much of each venue to pull per cycle. Gamma caps page size at 100.
POLYMARKET_PAGE_LIMIT=100
POLYMARKET_MAX_PAGES=15
KALSHI_PAGE_LIMIT=200
KALSHI_MAX_PAGES=8

# Ignore markets too illiquid to trade. Applied per EVENT, never per outcome:
# filtering out one leg of a multi-outcome event would silently destroy its
# exhaustiveness and produce arbitrage that does not exist.
MIN_MARKET_VOLUME_USD=5000
MIN_MARKET_LIQUIDITY_USD=500

# --------------------------------------------------------- detection rules
# Arbitrage exists when the combined book B = sum(1/d) drops below 1;
# the margin is m = 1/B - 1.
MIN_ARB_MARGIN=0.004          # 0.4% floor - below this, fees eat the edge
MAX_ARB_MARGIN=0.25           # above this it is almost certainly bad data
SUSPECT_MARGIN=0.05           # flag and penalise anything fatter than 5%
MIN_CONFIDENCE=25             # 0-100 quality score floor

# Title similarity required before two venues' markets are treated as the
# same question. Hard guards on thresholds, dates and direction run first.
FUZZY_MATCH_THRESHOLD=82

# --- Execution zones -----------------------------------------------------
# A cross-venue arb is only real if ONE person can place BOTH legs. Venues are
# grouped into zones sharing a currency, a settlement convention and a
# plausible account footprint (see arbengine/venues.py):
#
#   us_prediction   Polymarket, Kalshi        USD $1 contracts
#   uk_exchange     Betfair, Smarkets         GBP back/lay exchanges
#   us_sportsbook   The Odds API books        USD fixed odds
#
# Pairing runs inside a zone and never across one, so Polymarket pairs with
# Kalshi and Betfair with Smarkets, but never Betfair with Kalshi. Turning
# this off surfaces pairs that need accounts in two jurisdictions and carry an
# unhedged FX leg worth more than the edge.
ENFORCE_ZONE_PAIRING=true

# ISO-3166 alpha-2 of where you actually trade from, e.g. GB or US. Blank means
# do not filter by location; set it and anything you could not legitimately
# place from there is hidden.
OPERATOR_JURISDICTION=

# Books this close to crossing are kept as a watchlist. On a normal cycle no
# book crosses at all, and these are the evidence that the engine is working.
NEAR_MISS_SLACK=0.02
MAX_NEAR_MISSES=40

# ---------------------------------------------------------------- sizing
BANKROLL=10000
DEFAULT_STAKE=500
MAX_STAKE_FRACTION_PER_EVENT=0.05   # cap exposure to any one event
MIN_STAKE_PER_LEG=5
MIN_TOTAL_STAKE=20

# ------------------------------------------------------------------ fees
# Kalshi: fee = ceil(coefficient * contracts * P * (1-P)), peaking at P=0.50.
KALSHI_FEE_COEFFICIENT=0.07
KALSHI_MAKER_FEE_COEFFICIENT=0.0025
# Polymarket's CLOB currently charges no taker fee.
POLYMARKET_FEE_BPS=0
POLYMARKET_GAS_COST_USD=0
EXCHANGE_COMMISSION=0.02
# Exchanges take a share of NET WINNINGS rather than pricing a margin into the
# odds, so p_eff = p / (1 - c(1-p)). Unlike Kalshi's fee, which peaks at 0.50,
# this one bites hardest at long odds.
SMARKETS_COMMISSION=0.02
BETFAIR_COMMISSION=0.05

# --------------------------------------------------------------- scanner
POLL_INTERVAL_SECONDS=45
DEDUP_WINDOW_SECONDS=300
AUTOSTART_SCANNER=true
DEMO_MODE=false               # true = deterministic fixtures, no network

# Halt and page a human if a burst of implausible margins appears: that means
# the feed or the matcher is wrong, not that the market has gone mad.
BREAKER_THRESHOLD=25
BREAKER_WINDOW_SECONDS=60
BREAKER_MIN_MARGIN=0.10

# --------------------------------------------------------------- storage
DATABASE_PATH=data/betswin.db
RETENTION_DAYS=30

# -------------------------------------------------------------- alerting
# Create a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_MARGIN=0.015
ALERT_MIN_CONFIDENCE=55

# ------------------------------------------------- risk model assumptions
# Used for void-adjusted edge and backtests: E[pi] = (1-v)*m - v*L
ASSUMED_VOID_RATE=0.02
ASSUMED_VOID_LOSS=0.30
